ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_openai_api_key
PROSPER_EHR_URL=http://127.0.0.1:8000
PROSPER_DB_URL=sqlite:///data/ehr.db
PROSPER_BOT_MODEL=gpt-4o-mini
# Optional: when the primary model fails after retries, fall back to this one.
PROSPER_BOT_FALLBACK_MODEL=gpt-4o
# Set to 1 in production so missing API keys fail-fast (SystemExit before the
# ~17s pipecat/silero/onnxruntime import wall). Leave unset for tests.
PROSPER_BOT_ENTRYPOINT=1
